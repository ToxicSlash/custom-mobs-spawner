{
  "schemaVersion": 1,
  "id": "cmobs",
  "version": "${version}",
  "name": "Custom Mobs Spawner",
  "description": "Data-driven custom mob replacements and natural spawn rules.",
  "authors": [
    "ashtonthedev"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ashtonthedev.custommobsspawner.CustomMobsSpawner",
      "net.smitherz.SmitherzMain"
    ],
    "client": [
      "com.ashtonthedev.custommobsspawner.client.CustomMobsSpawnerClient",
      "net.smitherz.SmitherzClient"
    ],
    "modmenu": [
      "net.smitherz.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "cmobs.mixins.json",
    "smitherz.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "spell_engine": ">=0.15.12",
    "spell_power": ">=0.12.0",
    "zenith_attributes": ">=0.2.10",
    "cloth-config2": ">=${cloth_config_version}",
    "libz": ">=${libz_version}",
    "autotag-convention": ">=${autotag_version}",
    "advanced_runtime_resource_pack": ">=${arrp_version}"
  },
  "suggests": {
    "modmenu": "*",
    "rpgdifficulty": "*",
    "tiered": "*"
  }
}
